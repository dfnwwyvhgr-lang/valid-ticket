<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ticket</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://unpkg.com/html5-qrcode"></script>

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", Arial, sans-serif;
  background: #f2f2f7;
  color: #111;
}

header {
  background: #111;
  color: white;
  padding: 22px 18px;
  text-align: center;
}

header h1 {
  margin: 0;
  font-size: 30px;
  letter-spacing: -1px;
}

header p {
  margin: 6px 0 0;
  opacity: .65;
}

.container {
  max-width: 600px;
  margin: auto;
  padding: 18px;
}

.card {
  background: white;
  border-radius: 20px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 5px 20px rgba(0,0,0,.06);
}

h2 {
  margin-top: 0;
}

input, button {
  width: 100%;
  padding: 15px;
  border-radius: 13px;
  border: 1px solid #ddd;
  font-size: 16px;
  margin-top: 10px;
}

button {
  background: #111;
  color: white;
  border: none;
  font-weight: 700;
  cursor: pointer;
}

button.secondary {
  background: #e9e9ee;
  color: #111;
}

.stats {
  display: flex;
  gap: 10px;
  margin-bottom: 16px;
}

.stat {
  flex: 1;
  background: white;
  padding: 16px;
  border-radius: 17px;
  text-align: center;
}

.stat strong {
  display: block;
  font-size: 27px;
}

.ticket {
  background: white;
  border-radius: 22px;
  overflow: hidden;
  margin-bottom: 20px;
  box-shadow: 0 7px 25px rgba(0,0,0,.12);
}

.ticket-top {
  background: linear-gradient(135deg, #111 0%, #333 100%);
  color: white;
  padding: 22px;
  position: relative;
}

.ticket-top h2 {
  margin: 0;
  font-size: 25px;
}

.ticket-top p {
  margin: 7px 0 0;
  opacity: .7;
}

.ticket-middle {
  padding: 20px;
}

.ticket-info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.info small {
  color: #888;
  display: block;
  margin-bottom: 4px;
}

.info strong {
  font-size: 17px;
}

.ticket-qr {
  text-align: center;
  padding: 15px 0;
}

.ticket-qr canvas,
.ticket-qr img {
  margin: auto;
}

.ticket-bottom {
  border-top: 2px dashed #ddd;
  padding: 16px 20px;
  text-align: center;
  color: #777;
  font-size: 13px;
}

.ticket-number {
  font-weight: bold;
  color: #111;
}

.used {
  opacity: .6;
}

.badge {
  display: inline-block;
  padding: 6px 10px;
  border-radius: 20px;
  background: #e8f8ed;
  color: #16833b;
  font-size: 13px;
  font-weight: 700;
  margin-top: 10px;
}

.badge.used {
  background: #ffe8e8;
  color: #c62828;
}

#reader {
  width: 100%;
  overflow: hidden;
  border-radius: 16px;
  margin-top: 15px;
}

.result {
  padding: 18px;
  border-radius: 16px;
  text-align: center;
  font-weight: bold;
  margin-top: 15px;
  display: none;
}

.valid {
  background: #dff7e5;
  color: #137333;
}

.invalid {
  background: #ffe1e1;
  color: #b00020;
}

.hidden {
  display: none;
}

.small {
  color: #777;
  font-size: 13px;
}
</style>
</head>

<body>

<header>
  <h1>🎟️ Ticket</h1>
  <p>Gestion des entrées</p>
</header>

<div class="container">

  <div class="stats">
    <div class="stat">
      <strong id="total">0</strong>
      Billets
    </div>

    <div class="stat">
      <strong id="entered">0</strong>
      Entrées
    </div>

    <div class="stat">
      <strong id="remaining">0</strong>
      Restants
    </div>
  </div>

  <div class="card">
    <h2>⚙️ Événement</h2>

    <input id="eventName" placeholder="Nom de la soirée">

    <input id="ticketPrice" type="number" placeholder="Prix du billet (€)">

    <button onclick="saveEvent()">Enregistrer l'événement</button>
  </div>

  <div class="card">
    <h2>➕ Créer un billet</h2>

    <input id="firstName" placeholder="Prénom">

    <input id="lastName" placeholder="Nom">

    <button onclick="createTicket()">Créer le billet</button>

    <p class="small">
      Le billet est considéré comme payé lors de sa création.
    </p>
  </div>

  <div class="card">
    <h2>📷 Scanner un billet</h2>

    <button onclick="startScanner()">Ouvrir la caméra</button>

    <div id="reader"></div>

    <div id="scanResult" class="result"></div>
  </div>

  <div class="card">
    <h2>🎟️ Billets créés</h2>

    <div id="tickets"></div>
  </div>

</div>

<script>

let tickets = JSON.parse(localStorage.getItem("tickets") || "[]");

let eventData = JSON.parse(
  localStorage.getItem("eventData") ||
  '{"name":"","price":""}'
);

document.getElementById("eventName").value = eventData.name;
document.getElementById("ticketPrice").value = eventData.price;

function saveEvent() {

  eventData = {
    name: document.getElementById("eventName").value || "Soirée",
    price: document.getElementById("ticketPrice").value || "0"
  };

  localStorage.setItem("eventData", JSON.stringify(eventData));

  alert("Événement enregistré !");
  render();
}

function randomCode(length = 10) {

  const chars =
    "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

  let result = "";

  for (let i = 0; i < length; i++) {
    result += chars.charAt(
      Math.floor(Math.random() * chars.length)
    );
  }

  return result;
}

function createTicket() {

  const firstName =
    document.getElementById("firstName").value.trim();

  const lastName =
    document.getElementById("lastName").value.trim();

  if (!firstName || !lastName) {
    alert("Entre le prénom et le nom.");
    return;
  }

  const code = randomCode();

  const ticket = {
    id: crypto.randomUUID(),
    code: code,
    firstName: firstName,
    lastName: lastName,
    event: eventData.name || "Soirée",
    price: eventData.price || "0",
    used: false,
    createdAt: new Date().toISOString(),
    usedAt: null
  };

  tickets.push(ticket);

  saveTickets();

  document.getElementById("firstName").value = "";
  document.getElementById("lastName").value = "";

  render();

  setTimeout(() => {

    const element =
      document.getElementById("qr-" + ticket.id);

    if (element) {

      new QRCode(element, {
        text: ticket.code,
        width: 180,
        height: 180,
        correctLevel: QRCode.CorrectLevel.H
      });

    }

  }, 100);

  alert("Billet créé !");
}

function saveTickets() {

  localStorage.setItem(
    "tickets",
    JSON.stringify(tickets)
  );
}

function render() {

  const container =
    document.getElementById("tickets");

  container.innerHTML = "";

  let entered = 0;

  tickets.forEach(ticket => {

    if (ticket.used) entered++;

    const div =
      document.createElement("div");

    div.className =
      "ticket" + (ticket.used ? " used" : "");

    div.innerHTML = `

      <div class="ticket-top">

        <h2>${escapeHTML(ticket.event)}</h2>

        <p>Billet d'entrée officiel</p>

      </div>

      <div class="ticket-middle">

        <div class="ticket-info">

          <div class="info">
            <small>Participant</small>
            <strong>
              ${escapeHTML(ticket.firstName)}
              ${escapeHTML(ticket.lastName)}
            </strong>
          </div>

          <div class="info">
            <small>Prix</small>
            <strong>${ticket.price} €</strong>
          </div>

          <div class="info">
            <small>Billet</small>
            <strong>#${String(tickets.indexOf(ticket)+1).padStart(3,"0")}</strong>
          </div>

          <div class="info">
            <small>Code</small>
            <strong>${ticket.code}</strong>
          </div>

        </div>

        <div class="ticket-qr">

          <div id="qr-${ticket.id}"></div>

          ${
            ticket.used
            ? '<span class="badge used">DÉJÀ UTILISÉ</span>'
            : '<span class="badge">VALIDE</span>'
          }

        </div>

      </div>

      <div class="ticket-bottom">

        <div class="ticket-number">
          ${ticket.code}
        </div>

        ${
          ticket.used
          ? `Entrée enregistrée le
             ${new Date(ticket.usedAt).toLocaleString("fr-FR")}`
          : "Présentez ce QR code à l'entrée"
        }

      </div>
    `;

    container.appendChild(div);

    setTimeout(() => {

      const qrElement =
        document.getElementById("qr-" + ticket.id);

      if (qrElement) {

        new QRCode(qrElement, {
          text: ticket.code,
          width: 180,
          height: 180,
          correctLevel: QRCode.CorrectLevel.H
        });

      }

    }, 0);

  });

  document.getElementById("total").textContent =
    tickets.length;

  document.getElementById("entered").textContent =
    entered;

  document.getElementById("remaining").textContent =
    tickets.length - entered;
}

function validateTicket(code) {

  code = code.trim();

  const ticket =
    tickets.find(t => t.code === code);

  const result =
    document.getElementById("scanResult");

  result.style.display = "block";

  if (!ticket) {

    result.className =
      "result invalid";

    result.innerHTML =
      "❌ BILLET INVALIDE<br><small>Ce QR code n'existe pas.</small>";

    return;

  }

  if (ticket.used) {

    result.className =
      "result invalid";

    result.innerHTML =
      "🔴 BILLET DÉJÀ UTILISÉ<br>" +
      "<small>" +
      escapeHTML(ticket.firstName) +
      " " +
      escapeHTML(ticket.lastName) +
      "</small>";

    return;

  }

  ticket.used = true;
  ticket.usedAt = new Date().toISOString();

  saveTickets();
  render();

  result.className =
    "result valid";

  result.innerHTML =
    "✅ ENTRÉE AUTORISÉE<br>" +
    "<strong>" +
    escapeHTML(ticket.firstName) +
    " " +
    escapeHTML(ticket.lastName) +
    "</strong><br>" +
    "<small>Billet validé avec succès</small>";
}

let scanner = null;

function startScanner() {

  if (scanner) return;

  scanner = new Html5Qrcode("reader");

  scanner.start(

    { facingMode: "environment" },

    {
      fps: 10,
      qrbox: {
        width: 250,
        height: 250
      }
    },

    decodedText => {

      validateTicket(decodedText);

      scanner.stop()
        .then(() => {
          scanner.clear();
          scanner = null;
        })
        .catch(() => {
          scanner = null;
        });

    },

    errorMessage => {
      // Les erreurs de lecture normales sont ignorées.
    }

  ).catch(error => {

    alert(
      "Impossible d'ouvrir la caméra. " +
      "Vérifie que tu as autorisé l'accès à la caméra."
    );

    scanner = null;

  });
}

function escapeHTML(text) {

  return String(text)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

render();

</script>

</body>
</html>
